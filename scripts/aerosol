#!/bin/bash
# Mac host launcher. All system provisioning runs inside the Ubuntu guest.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STATE="$ROOT/.aerosol"
export LIMA_HOME="$STATE/lima"
export LIMA_CACHE_HOME="$STATE/cache"
LIMA="$STATE/tools/bin/limactl"
CPUS=4 MEMORY=4 DISK=60 PORT=8080
OVERRIDES=false
fail() { echo "Error: $*" >&2; exit 1; }
usage() {
    cat <<'HELP'
Usage: ./scripts/aerosol <command> [options]
  up       Install/start the native ARM64 Ubuntu VM and wait for the dashboard
  stop     Gracefully shut down the VM, preserving all apps and data
  status   Show VM status
  doctor   Check guest services, architecture, storage and dashboard
  logs     Show recent guest service logs
  shell    Open a shell in the Ubuntu guest
  config   Print the VM configuration without changing anything
  help     Show this help

First creation options (also accepted by config):
  --cpus N       vCPUs (default 4)
  --memory N     RAM in GiB (default 4)
  --disk N       Sparse guest disk in GiB, minimum 20 (default 60)
  --port N       Localhost dashboard port (default 8080)

State stays in .aerosol/ inside this checkout. No host sudo or shared folders.
The initial install deploys the current committed HEAD, not uncommitted edits.
HELP
}
COMMAND="${1:-help}"
[[ $# -eq 0 ]] || shift
case "$COMMAND" in
    help|-h|--help) usage; exit 0 ;;
    up|stop|status|doctor|logs|shell|config) ;;
    *) fail "Unknown command: $COMMAND" ;;
esac
while [[ $# -gt 0 ]]; do
    [[ "$COMMAND" == up || "$COMMAND" == config ]] || fail "Options are only supported for up and config"
    [[ $# -ge 2 ]] || fail "Missing value for $1"
    [[ "$2" =~ ^[1-9][0-9]*$ && ${#2} -le 5 ]] || fail "Expected a positive decimal integer for $1"
    OVERRIDES=true
    case "$1" in
        --cpus) CPUS="$2" ;;
        --memory) MEMORY="$2" ;;
        --disk) DISK="$2" ;;
        --port) PORT="$2" ;;
        *) fail "Unknown option: $1" ;;
    esac
    shift 2
done
[[ "$DISK" -ge 20 ]] || fail "Disk must be at least 20 GiB"
[[ "$PORT" -ge 1024 && "$PORT" -le 65535 ]] || fail "Port must be between 1024 and 65535"
render_config() {
    sed -e "s/__CPUS__/$CPUS/g" -e "s/__MEMORY__/$MEMORY/g" \
        -e "s/__DISK__/$DISK/g" -e "s/__PORT__/$PORT/g" "$ROOT/macos/lima.yaml.in"
}
if [[ "$COMMAND" == config ]]; then render_config; exit 0; fi
[[ "$(uname -s)" == Darwin && "$(uname -m)" == arm64 ]] || fail "Aerosol requires an Apple Silicon Mac"
[[ "$(sw_vers -productVersion | cut -d. -f1)" -ge 13 ]] || fail "macOS 13 or newer is required"
[[ "$(id -u)" -ne 0 ]] || fail "Run as your normal Mac user, never with sudo"

shell_guest() { "$LIMA" shell --workdir /tmp aerosol "$@"; }
wait_dashboard() {
    local attempt
    for ((attempt=0; attempt<90; attempt++)); do
        if curl --noproxy '*' -fsS --max-time 2 "http://127.0.0.1:$PORT/setup" -o /dev/null; then
            echo "Aerosol is ready: http://lvh.me:$PORT/"
            return
        fi
        sleep 2
    done
    fail "Dashboard not ready. Run ./scripts/aerosol doctor and ./scripts/aerosol logs"
}
if [[ "$COMMAND" == up ]]; then
    mkdir -p "$STATE"
    mkdir "$STATE/up.lock" 2>/dev/null || fail "Another up operation holds .aerosol/up.lock. If it crashed, remove that empty directory and retry."
    trap 'rmdir "$STATE/up.lock"' EXIT
    if [[ ! -x "$LIMA" ]]; then bash "$ROOT/macos/install-lima.sh"; fi
    if [[ -f "$LIMA_HOME/aerosol/lima.yaml" ]]; then
        [[ "$OVERRIDES" == false ]] || fail "VM already exists; first-creation options cannot resize it. See docs/src/setup/apple_silicon.md"
        [[ -f "$STATE/port" ]] || fail "Missing .aerosol/port; recover it from the VM configuration before starting"
        PORT="$(cat "$STATE/port")"
        "$LIMA" start --tty=false aerosol
    else
        HOST_CPUS="$(sysctl -n hw.ncpu)"
        HOST_MEMORY="$(sysctl -n hw.memsize)"
        [[ "$CPUS" -le "$HOST_CPUS" ]] || fail "Requested CPUs exceed this Mac's $HOST_CPUS cores"
        [[ "$MEMORY" -le $((HOST_MEMORY / 1073741824 / 2)) ]] || fail "Leave at least half of this Mac's RAM for macOS"
        if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then fail "Local port $PORT is already in use; choose --port"; fi
        git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet || fail "Commit tracked changes before installing so the guest matches this checkout"
        render_config > "$STATE/aerosol.yaml"
        printf '%s\n' "$PORT" > "$STATE/port"
        "$LIMA" start --tty=false --name=aerosol "$STATE/aerosol.yaml"
    fi
    if ! shell_guest test -f /var/lib/aerosol/provisioned; then
        echo "Installing the current committed source in Ubuntu. This can take 10-20 minutes."
        git -C "$ROOT" bundle create "$STATE/source.bundle" HEAD
        "$LIMA" copy "$STATE/source.bundle" aerosol:/tmp/aerosol-source.bundle
        "$LIMA" copy "$ROOT/macos/provision-guest.sh" aerosol:/tmp/aerosol-provision.sh
        shell_guest sudo bash /tmp/aerosol-provision.sh "$PORT"
    fi
    wait_dashboard
    exit 0
fi
[[ -x "$LIMA" && -f "$LIMA_HOME/aerosol/lima.yaml" ]] || fail "No Aerosol VM installed. Run ./scripts/aerosol up"
PORT="$(cat "$STATE/port")"
case "$COMMAND" in
    stop) "$LIMA" stop --tty=false aerosol ;;
    status) "$LIMA" list aerosol ;;
    logs) shell_guest sudo journalctl -u openhost -u openhost-system-agent --no-pager -n 100 ;;
    shell) "$LIMA" shell --workdir /home/host/openhost aerosol ;;
    doctor)
        "$LIMA" list aerosol
        shell_guest bash -c 'set -e; uname -m; cat /etc/os-release; findmnt -no FSTYPE /home; df -h /; free -h; systemctl is-active openhost; sudo -iu host bash -c "cd /home/host/openhost && /home/host/.pixi/bin/pixi run podman info --format json"'
        wait_dashboard
        ;;
esac
